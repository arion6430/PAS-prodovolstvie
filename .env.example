# Скопируйте в .env и при необходимости измените.
# Путь к файлу хранилища DuckDB
FOODPRICES_DB=data/warehouse.duckdb
# Каталог для сырых ответов источников (слой raw)
FOODPRICES_RAW_DIR=data/raw
# Путь к основному конфигу
FOODPRICES_CONFIG=config/config.yaml
# Уровень логирования: DEBUG, INFO, WARNING
FOODPRICES_LOG_LEVEL=INFO
