# Скопируйте в .env:  cp .env.example .env   — и при желании смените пароли.
# Файл .env в репозиторий не попадает.

# --- PostgreSQL (суперпользователь контейнера) ---
POSTGRES_PASSWORD=postgres_admin_pwd
# порт на хост-машине (внутри сети docker всегда 5432)
POSTGRES_HOST_PORT=5433

# --- Хранилище проекта ---
WAREHOUSE_DB=foodprices
WAREHOUSE_USER=foodprices
WAREHOUSE_PASSWORD=foodprices_pwd
# для запуска загрузчиков с хост-машины; в контейнерах переопределяется на postgres:5432
WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5433

# --- Роль только для чтения витрин (Superset) ---
BI_READER_USER=bi_reader
BI_READER_PASSWORD=bi_reader_pwd

# --- Метаданные Airflow и Superset ---
AIRFLOW_DB_PASSWORD=airflow_pwd
SUPERSET_DB_PASSWORD=superset_pwd

# --- Веб-интерфейсы ---
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
SUPERSET_PORT=8088
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_SECRET_KEY=change_me_to_a_long_random_string
AIRFLOW_JWT_SECRET=change_me_to_another_long_random_string

# --- Конвейер ---
FOODPRICES_RAW_DIR=data/raw
FOODPRICES_CONFIG=config/config.yaml
FOODPRICES_LOG_LEVEL=INFO
